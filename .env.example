# Copie para .env na raiz. Cada integrante usa SUA chave; nunca versionar .env.
# A chave pertence somente ao backend. Não use prefixo VITE_ para credenciais.
GEMINI_API_KEY=
MANAGERAI_GEMINI_MODEL=gemini-2.5-flash
# Só ative depois de conferir no AI Studio que o projeto está no plano gratuito.
# O aplicativo não consegue verificar o faturamento da conta do Google.
MANAGERAI_GEMINI_ENABLED=false
# Caminho opcional dos dados, relativo à raiz ao iniciar pelo run_web.py:
# MANAGERAI_DATA_ROOT=open-data/data
