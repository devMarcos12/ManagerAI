# Configuração privada por instalação/backend. Nunca versionar o .env pessoal.
MANAGERAI_AI_PROVIDER=groq
GROQ_API_KEY=
MANAGERAI_GROQ_MODEL=openai/gpt-oss-120b
# Ative somente com sua conta no Free Plan. A aplicação não verifica faturamento.
MANAGERAI_GROQ_ENABLED=false
# Gemini é preservado como opção explícita, sem fallback automático:
GEMINI_API_KEY=
MANAGERAI_GEMINI_MODEL=gemini-2.5-flash
MANAGERAI_GEMINI_ENABLED=false
# MANAGERAI_DATA_ROOT=open-data/data
